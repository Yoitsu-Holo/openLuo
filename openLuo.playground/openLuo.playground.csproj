<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>openLuo.Playground</RootNamespace>
    <AssemblyName>openLuo.Playground</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 演示工程：直接装配内核（**不依赖宿主 exe**，与扩展同一套边界）；入口 Program.cs 自包含，无 args 调度 -->
    <ProjectReference Include="..\openLuo.Application\openLuo.Application.csproj" />
    <ProjectReference Include="..\openLuo.AgentContext\openLuo.AgentContext.csproj" />
    <ProjectReference Include="..\openLuo.Capabilities\openLuo.Capabilities.csproj" />
    <ProjectReference Include="..\openLuo.Capabilities.Llm\openLuo.Capabilities.Llm.csproj" />
    <ProjectReference Include="..\openLuo.Llm\openLuo.Llm.csproj" />
  </ItemGroup>
</Project>

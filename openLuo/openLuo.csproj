<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>openLuo</RootNamespace>
    <AssemblyName>openLuo</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 只声明**宿主自身代码**真正使用的包（驱动包由各自前端/内核工程声明，见 docs/architecture/hub-protocol.md §3）：
       Avalonia/Terminal.Gui/CommunityToolkit.Mvvm → openLuo.Gui / openLuo.Tui
       Milky.Net.Client → 已无使用（OneBot 为手写实现）
       SkiaSharp → openLuo.playgraound；ReadLine → 无使用
       Microsoft.Extensions.AI → openLuo.Embedding；SQLitePCLRaw → openLuo.Foundation
       经验：ProjectReference 会传递依赖，因此"exe 里再 pin 一遍"只会让版本出现两个来源、并掩盖真实归属。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\openLuo.Foundation\openLuo.Foundation.csproj" />
    <ProjectReference Include="..\openLuo.Llm\openLuo.Llm.csproj" />
    <ProjectReference Include="..\openLuo.Embedding\openLuo.Embedding.csproj" />
    <ProjectReference Include="..\openLuo.Memory\openLuo.Memory.csproj" />
    <ProjectReference Include="..\openLuo.AgentContext\openLuo.AgentContext.csproj" />
    <ProjectReference Include="..\openLuo.Capabilities\openLuo.Capabilities.csproj" />
    <ProjectReference Include="..\openLuo.Capabilities.Llm\openLuo.Capabilities.Llm.csproj" />
    <ProjectReference Include="..\openLuo.Capabilities.Mcp\openLuo.Capabilities.Mcp.csproj" />
    <ProjectReference Include="..\openLuo.Capabilities.A2A\openLuo.Capabilities.A2A.csproj" />
    <ProjectReference Include="..\openLuo.Abstractions\openLuo.Abstractions.csproj" />
    <ProjectReference Include="..\openLuo.Cli\openLuo.Cli.csproj" />
    <ProjectReference Include="..\openLuo.Tui\openLuo.Tui.csproj" />
    <ProjectReference Include="..\openLuo.Gui\openLuo.Gui.csproj" />
    <ProjectReference Include="..\openLuo.Qqbot\openLuo.Qqbot.csproj" />
    <ProjectReference Include="..\openLuo.OneBot\openLuo.OneBot.csproj" />
    <ProjectReference Include="..\openLuo.Server\openLuo.Server.csproj" />
    <ProjectReference Include="..\openLuo.Client\openLuo.Client.csproj" />
    <ProjectReference Include="..\openLuo.Modules.WorldState\openLuo.Modules.WorldState.csproj" />
    <ProjectReference Include="..\openLuo.Domain\openLuo.Domain.csproj" />
    <ProjectReference Include="..\openLuo.Modules.Agent\openLuo.Modules.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native\sqlite-vec\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>openLuo</RootNamespace>
    <AssemblyName>openLuo</AssemblyName>
  </PropertyGroup>

  <!-- 宿主 exe 只保留入口：内核装配、组合根、宿主编排全部在 openLuo.Application
       （AssemblyBoundaryTests 断言"服务端 exe 只依赖 Application"，防止内核代码回流，见 docs/architecture/hub-protocol.md §3）。 -->
  <ItemGroup>
    <ProjectReference Include="..\openLuo.Application\openLuo.Application.csproj" />
    <ProjectReference Include="..\openLuo.Protocol\openLuo.Protocol.csproj" />
  </ItemGroup>

  <!-- 运行期资源布局：data/（示例配置、插件、技能、表情）与 native/（sqlite-vec）。
       放在 exe 上是因为发布产物以 exe 为根；Content 不随 ProjectReference 传递，故不能挪到应用层。 -->
  <ItemGroup>
    <Content Include="data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="native\sqlite-vec\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

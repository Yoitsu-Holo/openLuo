{
  // ===== Executor 独立配置 =====
  // 每个 executor 的温度和最大 token 数
  // [热加载] 修改后自动生效
  //
  // NOTE: 温度建议不低于 0.3（flowRouting/giftIntent 等分类任务除外），
  // 过低的温度（如 0.1）可能导致模型陷入循环重复。
  // 键名与内核 ExecutorConfigs 对齐：characterResponse / stateUpdate / toolUse /
  // flowRouting / giftIntent / todoList / goalExecution（其余键会被忽略）。

  "executors": {
    "characterResponse": { "temperature": 0.7, "maxTokens": null },
    "stateUpdate": { "temperature": 0.1, "maxTokens": 2048 },
    "toolUse": { "temperature": 0.2, "maxTokens": 2048 },
    "flowRouting": { "temperature": 0.0, "maxTokens": 512 },
    "giftIntent": { "temperature": 0.0, "maxTokens": 512 },
    "todoList": { "temperature": 0.2, "maxTokens": 2048 },
    "goalExecution": { "temperature": 0.2, "maxTokens": 2048 }
  }
}

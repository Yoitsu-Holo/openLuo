{
  // ===== LLM 提供商配置 =====
  // [热加载] 修改后自动生效
  // 拷贝此文件为 llm.jsonc 并填入你的 apiKey

  "llm": {
    // 推荐：多模型路由模式。LLM 层只看结构化能力需求，不解析用户语义。
    // priority 越大越优先；DeepSeek 可作为快文本模型，Qwen 可作为低优先级视觉模型。
    "routes": [
      {
        "name": "deepseek-fast-text",
        "enabled": true,
        "priority": 100,
        "provider": "DeepSeek",
        "baseUrl": "https://api.deepseek.com/v1/",
        "apiKey": "",
        "model": "deepseek-chat",
        "temperature": 0.5,
        "maxTokens": null,
        "streaming": false,
        "timeoutSeconds": 60,
        "maxRetryAttempts": 5,
        "baseDelayMs": 2500,
        "rateLimitPerMinute": 30,
        "capabilities": {
          "supportsVision": false,
          "supportsJsonMode": true,
          "supportsStreaming": true,
          "supportsTools": true
        }
      },
      {
        "name": "qwen-vision",
        "enabled": true,
        "priority": 50,
        "provider": "Qwen",
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1/",
        "apiKey": "",
        "model": "qwen-vl-plus",
        "temperature": 0.7,
        "maxTokens": null,
        "streaming": false,
        "timeoutSeconds": 120,
        "maxRetryAttempts": 5,
        "baseDelayMs": 2500,
        "rateLimitPerMinute": 30,
        "capabilities": {
          "supportsVision": true,
          "supportsJsonMode": true,
          "supportsStreaming": true
        }
      }
    ]

    // route-only 模式：所有 provider/baseUrl/apiKey/model/capabilities 都必须写在 routes[*] 内。
    // llm 外层不再支持单模型 provider/baseUrl/apiKey/model/capabilities 字段。
  }
}


<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>openLuo.Interfaces.QQbot</RootNamespace>
    <AssemblyName>openluo-qq</AssemblyName>
    <Description>QQ 桥（独立程序）：经 Wire 协议连 Hub（只依赖 openLuo.Protocol + openLuo.Client + openLuo.OneBot）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\openLuo.Client\openLuo.Client.csproj" />
    <ProjectReference Include="..\openLuo.OneBot\openLuo.OneBot.csproj" />
    <ProjectReference Include="..\openLuo.Protocol\openLuo.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 宿主级测试工程（openLuo.Tests）覆盖 QqBotApplication 的内部分段/批量逻辑 -->
    <InternalsVisibleTo Include="openLuo.Tests" />
  </ItemGroup>

</Project>
